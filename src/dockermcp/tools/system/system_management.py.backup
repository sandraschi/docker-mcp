            "ipv4_forwarding": info.get("IPv4Forwarding", False),
            "bridge_nf_iptables": info.get("BridgeNfIptables", False),
            "bridge_nf_ip6tables": info.get("BridgeNfIp6tables", False),
            "n_fd": info.get("NFd", 0),
