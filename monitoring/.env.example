# ====================================
# Docker MCP Monitoring Configuration
# ====================================

# -----------------------------
# Grafana Configuration
# -----------------------------
# Grafana admin credentials
GRAFANA_ADMIN_PASSWORD=your_secure_password_here
# Secret key for signing session data (auto-generated if empty)
GRAFANA_SECRET_KEY=

# -----------------------------
# Email Alert Configuration
# -----------------------------
# Required for email notifications and password resets
SMTP_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=alerts@yourdomain.com
SMTP_FROM_NAME="Docker MCP Alerts"
SMTP_STARTTLS_POLICY=OpportunisticStartTLS

# -----------------------------
# Loki Configuration
# -----------------------------
# For Docker Compose environment (uncomment one):
# LOKI_URL=http://loki:3100

# For external Loki or local development:
# LOKI_URL=http://localhost:3100

# -----------------------------
# Alert Recipients
# -----------------------------
# Add email addresses for alert recipients
# Format: ALERT_EMAIL_NAME=email@example.com
ALERT_EMAIL_ADMIN=admin@yourdomain.com
ALERT_EMAIL_DEVOPS=devops@yourdomain.com

# -----------------------------
# Environment Configuration
# -----------------------------
# Environment type (development/staging/production)
ENVIRONMENT=development

# Log retention period in hours (default: 720h = 30 days)
LOG_RETENTION_HOURS=720

# -----------------------------
# Backup Configuration
# -----------------------------
# Number of backups to keep (older backups will be deleted)
BACKUP_RETENTION_DAYS=7

# Backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# -----------------------------
# Resource Limits
# -----------------------------
# Adjust these based on your host system resources
GRAFANA_MEMORY_LIMIT=512M
PROMETHEUS_MEMORY_LIMIT=1G
LOKI_MEMORY_LIMIT=1G

# -----------------------------
# Security Settings
# -----------------------------
# Enable HTTPS (requires SSL certificates)
ENABLE_HTTPS=false
# SSL_CERT_PATH=./certs/fullchain.pem
# SSL_KEY_PATH=./certs/privkey.pem
